{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/data",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.tsbuildinfo",
      "!package-lock.json",
      "!**/AGENTS.md",
      "!PLAN.md",
      "!**/slop_list.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "assist": { "enabled": false },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useButtonType": "off",
        "useAltText": "off",
        "noStaticElementInteractions": "off",
        "noLabelWithoutControl": "off",
        "useAriaPropsSupportedByRole": "off"
      },
      "correctness": { "useExhaustiveDependencies": "off" },
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/api.test.ts"],
      "linter": { "rules": { "correctness": { "noUnsafeOptionalChaining": "off" } } }
    }
  ]
}
