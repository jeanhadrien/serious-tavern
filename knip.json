{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "apps/server": {
      "entry": ["src/main.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/main.tsx", "src/**/*.test.{ts,tsx}", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.config.ts"]
    },
    "packages/shared": {
      "entry": ["src/index.ts", "src/ports.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/engine": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/node-ui": {
      "entry": ["src/index.tsx"],
      "project": ["src/**/*.tsx"]
    }
  }
}
